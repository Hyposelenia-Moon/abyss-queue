# 三路深渊排队插件配置
#
# 全部字段都有默认值，只需按本机/服务器实际情况修改。

# 表格文件路径（绝对路径；也可写相对插件目录的路径）
# Windows 示例：D:/文件/游戏/原神/2026年10月三路深渊排队.xlsx
# Linux   示例：/opt/yunzai/data/2026年10月三路深渊排队.xlsx
xlsx_path: "D:/文件/游戏/原神/2026年10月三路深渊排队.xlsx"

# 默认榜：`#排队 全部` 不带榜名时使用
default_sheet: 幽境危战

# 列表显示条数（图片模式下即最大行数；0 = 全部）
list_limit: 20

# 是否用图片渲染队列 / 主播 / 菜单（渲染后端不可用时自动回退为文本）
render_image: true

# 出图分辨率倍数（设备像素比）：2 = 两倍宽高的高清图，字号与版式不变
# 需要截图后端支持 sys.scale（见 README「部署须知」）；填 1 回到旧行为
render_scale: 2

# 图片模式下每列的截断宽度（按显示宽度计，中文算 2；0 = 不截断）
# 名单只显示「序号 / 成员 / 完成情况」三列；本人信息单独完整给出
render_name_max: 40
render_status_max: 40

# 字体：首次渲染时从云端拉取原神风格字体并缓存到 data/fonts（不入库），之后离线可用
# 关闭后直接用系统字体渲染
font_download: true
# 字体镜像基地址（按顺序尝试；留空则用内置的 jsDelivr / raw.githubusercontent 多镜像）
font_mirrors: []


# 写表前是否备份为 <原文件名>.bak（插件本身不写表，这个开关留给同步脚本）
backup: true

# 主播别名：正名 → 别名（按正则整串匹配、忽略大小写）
# 表里/群里对同一位主播的其它写法（老昵称、简称）登记在这里，读的时候会归一成正名：
#   #主播 阿修 能查到 阿修Axiu；表里写「璃月第一深情」的行也算作摸头妹（直播入口照样带出来）
anchor_aliases:
  阿修Axiu: ["阿修"]
  摸头妹: ["璃月第一深情"]

# 临时：从腾讯文档同步排表（详见 tools/sync-doc.mjs）
# 数据依据是腾讯文档；插件只读本地那份同步过来的表。整段关掉就不参与同步
sync:
  enable: false
  # 文档地址
  doc_url: "https://docs.qq.com/sheet/DQURqWURTSWVCYmZQ"
  # 来源：留空 = 在线导出（需要登录态）；"latest" = 下载目录里最新的 xlsx；也可写具体文件
  from: ""
  # 同步到哪份表：留空 = 上面的 xlsx_path
  to: ""
  # 每次机器人启动时同步一次
  on_start: true
  # 腾讯文档 Cookie（一般不用填：脚本会自动从本机浏览器取）
  cookie: ""

# 定时推送（默认关闭；开启后按 cron 推送各榜概览）
push:
  enable: false
  cron: "0 12 * * *"
  groups: []
  sheets: []
  limit: 10

# 进度通知
#   progress_cron   多久检查一次「上一位是不是已经完成」，完成就 @ 下一位（跳过已完成的人）
#   monthly_cron    每天检查一次「今天是不是当月最后一天」，是就把还在排队的人 @ 一遍催进度
#   groups          发到哪些群；留空则跟随 push.groups
notify:
  enable: true
  groups: []
  progress_cron: "*/3 * * * *"
  monthly_cron: "0 12 * * *"
  monthly_enable: true
  # 进度快照（识别状态变化、避免重复 @）；想换目录可以写绝对路径
  state_file: data/progress.json

# QQ→行号 绑定数据文件（相对插件目录）
store_file: data/bindings.json
