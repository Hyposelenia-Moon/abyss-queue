# 三路深渊排队插件配置
#
# 全部字段都有默认值，只需按本机/服务器实际情况修改。

# ------------------------------------------------------------------
# 数据来源：云端编辑器（部署在服务器上）。插件**只读**它，不写任何表。
# 机器人按 ttl_ms 从 <url>/api/snapshot?k=<token> 拉一份 xlsx 快照解析出数据。
# 本机联调可以把 url 指到 http://127.0.0.1:7788（本机编辑器）。
# ------------------------------------------------------------------
remote:
  url: ""             # 云端编辑器地址，例：https://yunzai.axiu.uno/queue
  token: ""           # 与编辑器进程的 ABYSS_EDITOR_TOKEN 一致（会出现在每个人的链接里）
  # 身份签名密钥：与编辑器的 ABYSS_EDITOR_SIGN_KEY 一致。
  # 不配就退回用 token 签 —— 那样拿到链接的人能伪造别人的身份（包括主人），正式部署务必单独配。
  # 生成：openssl rand -hex 24
  sign_key: ""
  # 群里发短链：<url>/s/<16 字符码>（码不透明，编辑器验过后换成带身份的完整地址）。
  # 编辑器要同时更新（本仓库同一份代码）；云端还没更新时改成 false，退回长链接。
  short_link: true
  # 填报入口做成「点此填表」四个字本身可点（QQ 的 markdown 段）。
  # 默认关：多数群/账号不认机器人发的 markdown（实测 NTQQ 回「发送者版本过低」），
  # 虽然会自动退回纯文本链接，但每次都要先失败一次。确认能用再打开。
  link_markdown: false
  ttl_ms: 30000       # 内存快照有效期：这期间连续命令不再重复拉取
  timeout_ms: 15000   # 单次拉取超时
  # 本机联调兜底（可选）：拉不到时把这个脚本跑起来等几秒再试
  # 例：<Yunzai>/plugins/abyss-queue/data/editor-launch.mjs（数据目录固定在插件内）；正式部署留空
  autostart: ""

# ------------------------------------------------------------------
# 云端快照的本地备份：数据以云端为准，每次成功拉取都往本地写一份
# **只留最新的 keep 份**（默认 1），按日期命名覆盖写；dir 留空或 keep=0 = 不备份
# （别和下面的 `backup` 混了：那个是写表前的 .bak，只对编辑器的本地表生效）
# ------------------------------------------------------------------
snapshot_backup:
  dir: "data/backup"  # 相对路径按插件根解析
  keep: 1

# ------------------------------------------------------------------
# 群号（**都是可以自己改的**，改完重启机器人即生效）
#
#   1) notify.groups —— 「上一位完成后 @ 下一位」「榜开启提醒」「月末 @ 所有排队中的人」发到哪些群
#        可以写多个：groups: [123456789, 987654321]
#        留空 = 跟随 push.groups（那是老配置里的通知群号，见文件末尾）；两个都空 = 这些 @ 通知都不发
#   2) roster.group  —— 从这个群拉成员名单，做「群昵称候选」+ 按 QQ 对账（改名同步 / 退群删行）
#        只能填一个群；留空 = 关闭群名单（编辑器里就没有候选）
#
#   两者可以是不同的群：比如名单从主群拉，通知发到通知群。
# ------------------------------------------------------------------

# 群成员名单：机器人每天（启动时也推一次）把群成员推给在线编辑器
roster:
  group: ""           # 群号，例：123456789（填了才启用；换群号直接改这里）
  at: "05:00"         # 每天到这个时刻推一次（本地时间；到点之后一整天都算数）

# 通知：完成情况轮询 / 榜开启提醒 / 月末催办 / 群名单同步
#
# **只注册一条定时任务**（cron 就是下面的 notify.cron，默认每 3 分钟），
# 四件事都由它在内部按时间判断依次做，各自去重（重启、重复 tick 都不会重复发）。
# 上面那几个时刻是"到点之后一整天都算数"：机器人半夜关着、早上才起来也会补做一次。
notify:
  enable: true
  groups: []                      # 群号列表，例：[123456789]；留空则跟随 push.groups
  cron: "*/3 * * * *"             # 唯一那条任务的周期（旧的 progress_cron / monthly_cron 已被它取代）
  monthly_at: "12:00"             # 月末催办的时刻（每月最后一天）
  monthly_enable: true
  state_file: data/progress.json  # 状态文件：进度快照 + 每榜开启标记 + 当天已做的标记

# 默认榜：`#排队 全部` 不带榜名时使用
default_sheet: 幽境危战

# 列表显示条数（图片模式下即最大行数；0 = 全部）
list_limit: 20

# 是否用图片渲染队列 / 主播 / 菜单（渲染后端不可用时自动回退为文本）
render_image: true

# 出图分辨率倍数（设备像素比）：2 = 两倍宽高的高清图，字号与版式不变
# 需要截图后端支持 sys.scale（见 README「部署须知」）；填 1 回到旧行为
render_scale: 2

# 图片模式下每列的截断宽度（按显示宽度计，中文算 2；0 = 不截断）
# 名单只显示「序号 / 成员 / 完成情况」三列；本人信息单独完整给出
render_name_max: 40
render_status_max: 40

# 字体：首次渲染时从云端拉取原神风格字体并缓存到 data/fonts（不入库），之后离线可用
# 关闭后直接用系统字体渲染
font_download: true
# 字体镜像基地址（按顺序尝试；留空则用内置的 jsDelivr / raw.githubusercontent 多镜像）
font_mirrors: []


# 写表前是否备份为 <原文件名>.bak（插件不写表；这项只对编辑器的本地表生效）
backup: true

# 主播别名：正名 → 别名（按正则整串匹配、忽略大小写）
# 表里/群里对同一位主播的其它写法（老昵称、简称）登记在这里，读的时候会归一成正名：
#   #主播 阿修 能查到 阿修Axiu；表里写「璃月第一深情」的行也算作摸头妹（直播入口照样带出来）
anchor_aliases:
  阿修Axiu: ["阿修"]
  摸头妹: ["璃月第一深情"]

# 老配置兼容位：**定时推送功能已经删除**（连同 push.enable / push.cron / push.sheets / push.limit）
#
# 这里只剩 groups —— 它现在的唯一用途是当 notify.groups 的**通知群号回退**：
# notify.groups 留空时才读它，且不会再往群里推任何榜单文本。
# 老部署里原来的群号不用搬，新部署请直接写 notify.groups。
push:
  groups: []

# ------------------------------------------------------------------
# 编辑器页脚：**自定 HTML**
#
# 版权、备案号这些由维护者自己决定怎么排版，所以这里不拆字段、也不做校验：
#   footer.html 里的内容会被**原样插进页面**（编辑器首页 + 三个提示页：需要口令 / 仅主人可用 / 链接已失效）。
# 留空 = 不显示页脚（整块不渲染）。填什么自己负责——它只由维护者维护，不会读群友输入。
#
# 下面已经写好**首行署名**（两位维护者并列，与仓库 AGENTS.md 的权属一致）；备案号自己往后接，
# 例如（官方链接是硬要求，自己拼进去）：
#   <div><a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">京ICP备2026xxxxxx号-1</a></div>
#   <div><a href="https://beian.mps.gov.cn/#/query/webSearch?code=1101xxxxxxxxxx" target="_blank" rel="noreferrer">京公网安备1101xxxxxxxxxx号</a></div>
#
# 编辑器读的是**运行时的 config/config.yaml**；改完要重启编辑器进程（本机由启动器拉起，见 editor/README.md）。
# ------------------------------------------------------------------
footer:
  # 首行署名（`&` 用实体 `&amp;` 更稳；要改署名直接编辑这一行）
  html: |
    <div>© 2026 <a href="https://github.com/Hyposelenia-Moon">缄月</a> &amp; <a href="https://github.com/AxiuCN">阿修Axiu</a> · 由 <a href="https://github.com/Hyposelenia-Moon/abyss-queue">abyss-queue</a> 提供</div>

# QQ→行号 绑定数据文件（相对插件目录）
store_file: data/bindings.json
